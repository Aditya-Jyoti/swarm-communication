{
  "name": "swarm-net-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for swarm-net: a self-healing P2P swarm network in Go.",
  "scripts": {
    "dev": "vitepress dev .",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "check:ascii": "node scripts/check-ascii.mjs *.md architecture/*.md concepts/*.md",
    "check:mermaid": "node scripts/check-mermaid.mjs *.md architecture/*.md concepts/*.md",
    "check": "npm run check:ascii && npm run check:mermaid && npm run build"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
