{
  "name": "swarm-net-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for swarm-net: a self-healing P2P swarm network in Go.",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check:ascii": "node scripts/check-ascii.mjs docs/*.md docs/**/*.md",
    "docs:check:mermaid": "node scripts/check-mermaid.mjs docs/*.md docs/**/*.md",
    "docs:check": "npm run docs:check:ascii && npm run docs:check:mermaid && npm run docs:build"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
