# swarm-net Compose settings.
#
#   cp .env.example .env     # then edit .env (it is gitignored)
#
# Every variable is optional: docker-compose.yml carries the same defaults,
# so the stack also runs with no .env at all. Durations use Go syntax
# (500ms, 1s, 2m).

# ---------------------------------------------------------------- network
# Host address the published port binds to. Anyone who can reach the
# dashboard can submit tasks and kill nodes through it, so the default keeps
# it on loopback. Use 0.0.0.0 only on a trusted network.
BIND_ADDR=127.0.0.1
# Optional bearer token for the control center's mutating API (POST
# /api/tasks, POST /api/chaos, POST /api/sim, and commands over /ws).
# Empty = disabled.
# When set, the frontend's nginx adds it server-side, so the dashboard still
# works and the browser never sees it; callers that bypass nginx (other
# containers on the swarm network, a published CC port) need
# "Authorization: Bearer <token>". At least 16 characters from
# A-Z a-z 0-9 - . _ ~ + / =. Generate one with: openssl rand -hex 32
SWARM_CC_API_TOKEN=
# Host port for the dashboard (the frontend container listens on 8080).
FRONTEND_PORT=8080
# Host port for the control center's HTTP API when published directly.
# Only used if you uncomment the `ports:` block of `control-center` in
# docker-compose.yml; by default the CC is reachable only via the frontend.
CC_HTTP_PORT=18081

# ---------------------------------------------------------------- swarm size
# Replicas of the scalable `node` service. Total nodes N = 1 (seed) + this.
# `docker compose up --scale node=K` overrides it for one run.
NODE_REPLICAS=5
# Leader fraction in (0,1]. LeaderCount = max(1, ceil(N * threshold)).
SWARM_THRESHOLD=0.3

# ---------------------------------------------------------------- latency simulation
# Each node has a 3D position (0..100 per axis) and the control center turns
# distance into emulated latency: a node answering a PING delays its PONG by
#   delay = BASE + distance * PER_UNIT + JITTER * u,   u in [0, 1)
# clamped to 0..1500ms. Central nodes then win elections and workers join
# the nearest leader. These are start-up values; the dashboard's advanced
# panel (and POST /api/sim) changes them at run time.
# true | false. false turns the emulated delay off on every node.
SWARM_SIM_ENABLED=true
# Fixed part of every delay, in ms (0..500).
SWARM_SIM_BASE_MS=1
# Delay per unit of 3D distance, in ms (0..10).
SWARM_SIM_PER_UNIT_MS=2
# Random extra delay, uniform in [0, JITTER), in ms (0..200).
SWARM_SIM_JITTER_MS=0.5

# ---------------------------------------------------------------- timing
# How often each node scores its peers (latency probes).
SWARM_PROBE_INTERVAL=1s
# Silence before a connection is declared dead. Must exceed 3 * probe interval.
SWARM_IDLE_TIMEOUT=5s
# How often a node sends its full membership view to one random peer.
SWARM_GOSSIP_INTERVAL=2s
# Periodic re-election interval, on top of event-driven elections.
SWARM_ELECTION_FLOOR=30s
# How often each node reports telemetry to the control center.
SWARM_TELEMETRY_INTERVAL=1s

# ---------------------------------------------------------------- logging
# debug | info | warn | error. Applies to the nodes and the control center.
SWARM_LOG_LEVEL=info

# ---------------------------------------------------------------- images
# Tag for swarm-net/node, swarm-net/control-center and swarm-net/frontend.
SWARM_IMAGE_TAG=dev
# Version string baked into the Go binaries (`control-center -version`).
SWARM_VERSION=dev
# Base image versions used by the builds.
GO_VERSION=1.27
ALPINE_VERSION=3.24
NGINX_VERSION=1.31-alpine
