# swarm-net dashboard: static files plus a same-origin reverse proxy to the
# control center.
#
# The official nginx image renders /etc/nginx/templates/*.template with
# envsubst at start-up, substituting ONLY variables that are set in the
# environment; nginx's own $variables are left alone. Substituted here:
#   CONTROL_CENTER_UPSTREAM  host:port of the CC HTTP server (control-center:8080)
#   NGINX_LOCAL_RESOLVERS    nameservers from /etc/resolv.conf (exported by the
#                            image because NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1)
#   CC_API_TOKEN             the control center's API token, or empty (the
#                            Dockerfile defaults it to "", so it is always set)
#
# This file is included inside the main http {} block.

server_tokens off;

# API token, added server-side on /api/ and /ws so the browser never holds it.
# Empty token: the header is not sent at all (proxy_set_header with an empty
# value drops the header, including one the client sent). Non-empty: every
# request that reaches this proxy is authorised, so the token protects the CC
# from callers that bypass nginx, not from users of the dashboard; see
# backend/pkg/controlcenter/auth.go. The CC refuses to start with a token
# containing characters that would break this line (quotes, spaces, "$").
map "${CC_API_TOKEN}" $cc_authorization {
    ""      "";
    default "Bearer ${CC_API_TOKEN}";
}

# "Connection: upgrade" only when the client asked for one.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Matches the CC's own cap on a POST body or WebSocket message.
    client_max_body_size 64k;

    # Resolve the CC per request (valid=5s) instead of once at start-up. With
    # a literal upstream, nginx would refuse to start while control-center is
    # not resolvable yet, and would keep a stale IP after the CC container is
    # recreated. On a user-defined bridge the resolver is Docker's 127.0.0.11.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
    resolver_timeout 2s;
    set $control_center http://${CONTROL_CENTER_UPSTREAM};

    # --- security headers --------------------------------------------------
    # Declared once, at server level. add_header is NOT inherited by a
    # location that declares its own add_header, so no location below does.
    #
    # CSP: everything from this origin only. connect-src also names ws:/wss:
    # on this exact host, because older browsers do not let 'self' match a
    # WebSocket URL. The dashboard has no inline script or style attribute.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' ws://$http_host wss://$http_host; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # The dashboard is three small files; always revalidate so a rebuilt
    # image is picked up on the next reload.
    add_header Cache-Control "no-cache" always;

    # Container healthcheck. Answered by nginx itself, so the frontend stays
    # healthy while the CC restarts (the dashboard shows "reconnecting").
    location = /frontend-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # --- proxy to the control center ---------------------------------------
    # Host is passed through exactly as the browser sent it: $http_host keeps
    # the port, $host would drop it. The CC's WebSocket accept is same-origin
    # only (the Origin header's host:port must equal Host), so this is what
    # lets the dashboard's upgrade through, while a cross-origin page still
    # fails. proxy_pass takes a variable with no URI part, so the original
    # request URI is forwarded unchanged.

    location /api/ {
        proxy_pass $control_center;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $cc_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        proxy_pass $control_center;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location = /ws {
        proxy_pass $control_center;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization $cc_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        # The CC pushes a snapshot every second, but an idle socket may stay
        # open for a long time anyway; the dashboard reconnects on its own.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
}
